[Unit]
Description=KreatBio client portal API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=kreatbio-portal
Group=kreatbio-portal
WorkingDirectory=/opt/kreatbio-portal
EnvironmentFile=/etc/kreatbio-portal/runtime.env
Environment=SESSION_SECRET_FILE=/etc/kreatbio-portal/session-secret
Environment=GEMINI_API_KEY_FILE=/etc/kreatbio-portal/gemini-api-key
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
